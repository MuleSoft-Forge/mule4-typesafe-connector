<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:typesafe="http://www.mulesoft.org/schema/mule/typesafe"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/typesafe http://www.mulesoft.org/schema/mule/typesafe/current/mule-typesafe.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!-- Secrets live in src/main/resources/local.properties (gitignored). Never hard-code the key here. -->
	<configuration-properties file="local.properties" />

	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>

	<typesafe:config name="TypeSafe_Config" doc:name="TypeSafe Config">
		<typesafe:typesafe-connection apiKey="${typesafe.apiKey}" />
	</typesafe:config>

	<!-- Reusable sample ticket used by the decision flows. -->
	<sub-flow name="sample-ticket">
		<set-payload
			value='#[output application/json ---
{
  subject: "Charged twice for my subscription",
  body: "I was billed twice this month for the same plan and need a refund urgently before my card is charged again."
}]'
			doc:name="Sample ticket" />
	</sub-flow>

	<!-- ============================================================= -->
	<!-- [Util] Connection Get Capabilities  —  local, no provider call -->
	<!-- ============================================================= -->
	<flow name="get-capabilities-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/capabilities" allowedMethods="GET" />
		<logger level="INFO" category="typesafe.demo" message="[capabilities] ▶ requesting route capabilities" />
		<typesafe:get-capabilities config-ref="TypeSafe_Config" doc:name="[Util] Connection Get Capabilities" />
		<logger level="INFO" category="typesafe.demo" message="#['[capabilities] ◀ ' ++ write(payload, 'application/json')]" />
		<ee:transform doc:name="Transform Message" doc:id="5f6a8f38-acd5-4472-a55e-e8f2e62f788c" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	payload: payload,
	attributes: attributes
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<!-- ============================================================= -->
	<!-- [Util] Connection List Models  —  GET /{apiVersion}/models  -->
	<!-- ============================================================= -->
	<flow name="list-models-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/models" allowedMethods="GET" />
		<logger level="INFO" category="typesafe.demo" message="[models] ▶ listing models on connected routes" />
		<typesafe:list-models config-ref="TypeSafe_Config" doc:name="[Util] Connection List Models" />
		<logger level="INFO" category="typesafe.demo" message="#['[models] ◀ ' ++ write(payload, 'application/json')]" />
		<ee:transform doc:name="Transform Message" doc:id="558a38e1-b558-4274-9858-e2df67485bb6" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	payload: payload,
	attributes: attributes
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<!-- ============================================================= -->
	<!-- [Util] Validate Question Set  —  GET /validate                -->
	<!-- ============================================================= -->
	<flow name="validate-question-set-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/validate" allowedMethods="GET" />
		<logger level="INFO" category="typesafe.demo" message="[validate] ▶ validating question set 'ticket-triage'" />
		<typesafe:validate-question-set doc:name="[Util] Validate Question Set" doc:id="5392b875-c72a-4dc4-bd1f-a8eb44f0c717" config-ref="TypeSafe_Config"/>
		<logger level="INFO" category="typesafe.demo" message="#['[validate] ◀ ' ++ write(payload, 'application/json')]" />
		<ee:transform doc:name="Transform Message" doc:id="810aeece-f850-4211-98c2-b81f92dd14f4" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	payload: payload,
	attributes: attributes
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>

	<!-- ============================================================= -->
	<!-- [Decide] Evaluate  —  GET /evaluate                           -->
	<!-- ============================================================= -->
	<flow name="evaluate-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/evaluate" allowedMethods="GET" />
		<flow-ref name="sample-ticket" doc:name="Sample ticket" />
		<logger level="INFO" category="typesafe.demo" message="#['[evaluate] ▶ state=' ++ write(payload, 'application/json')]" />
		<typesafe:evaluate config-ref="TypeSafe_Config" questionSet="ticket-triage" step="triage" doc:name="[Decide] Evaluate">
			<typesafe:state>#[payload]</typesafe:state>
		</typesafe:evaluate>
		<logger level="INFO" category="typesafe.demo" message="#['[evaluate] ◀ answers=' ++ write(payload, 'application/json') ++ ' | provider=' ++ (attributes.provider default 'n/a') ++ ' cost=' ++ (attributes.cost default 'n/a')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- [Decide] Ask Yes/No  —  GET /ask                              -->
	<!-- ============================================================= -->
	<flow name="ask-noul-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/ask" allowedMethods="GET" />
		<flow-ref name="sample-ticket" doc:name="Sample ticket" />
		<logger level="INFO" category="typesafe.demo" message="[ask] ▶ asking whether the ticket is urgent" />
		<typesafe:ask-noul config-ref="TypeSafe_Config"
			instructions="Is this ticket time-sensitive and in need of a fast response?"
			criteriaTrue="Mentions an outage, a deadline, lost revenue, or an angry customer."
			criteriaFalse="A routine question or feature request with no time pressure."
			step="urgency" doc:name="[Decide] Ask Yes/No">
			<typesafe:state>#[payload]</typesafe:state>
		</typesafe:ask-noul>
		<logger level="INFO" category="typesafe.demo" message="#['[ask] ◀ ' ++ write(payload, 'application/json')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- [Decide] Choose  —  GET /choose                               -->
	<!-- ============================================================= -->
	<flow name="choose-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/choose" allowedMethods="GET" />
		<flow-ref name="sample-ticket" doc:name="Sample ticket" />
		<logger level="INFO" category="typesafe.demo" message="[choose] ▶ routing the ticket to a team" />
		<typesafe:choose config-ref="TypeSafe_Config"
			instructions="Which team should own this ticket, based on its subject and body?"
			noMatchOption="other" step="routing" doc:name="[Decide] Choose">
			<typesafe:state>#[payload]</typesafe:state>
			<typesafe:choose-options>
				<typesafe:choose-option key="billing" value="Payments, invoices, refunds and subscription changes." />
				<typesafe:choose-option key="technical" value="Product errors, outages, integration and API problems." />
				<typesafe:choose-option key="account" value="Login, access, roles and account administration." />
			</typesafe:choose-options>
		</typesafe:choose>
		<logger level="INFO" category="typesafe.demo" message="#['[choose] ◀ ' ++ write(payload, 'application/json')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- [Decide] Score  —  GET /score                                 -->
	<!-- ============================================================= -->
	<flow name="score-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/score" allowedMethods="GET" />
		<flow-ref name="sample-ticket" doc:name="Sample ticket" />
		<logger level="INFO" category="typesafe.demo" message="[score] ▶ scoring customer sentiment" />
		<typesafe:score config-ref="TypeSafe_Config"
			instructions="How positive is the customer's tone?" step="sentiment" doc:name="[Decide] Score">
			<typesafe:state>#[payload]</typesafe:state>
			<typesafe:levels>
				<typesafe:level value="very negative" />
				<typesafe:level value="negative" />
				<typesafe:level value="neutral" />
				<typesafe:level value="positive" />
				<typesafe:level value="very positive" />
			</typesafe:levels>
		</typesafe:score>
		<logger level="INFO" category="typesafe.demo" message="#['[score] ◀ ' ++ write(payload, 'application/json')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- [Select] Candidate  —  GET /select                            -->
	<!-- ============================================================= -->
	<flow name="select-candidate-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/select" allowedMethods="GET" />
		<logger level="INFO" category="typesafe.demo" message="[select] ▶ ranking queues against the request" />
		<typesafe:select-candidate config-ref="TypeSafe_Config"
			idField="id" labelField="name" descriptionField="description" step="select" doc:name="[Select] Candidate">
			<typesafe:candidates>#[output application/json ---
[
  { id: "billing-queue",   name: "Billing",   description: "Payments, invoices, refunds and subscription changes." },
  { id: "technical-queue", name: "Technical", description: "Product errors, outages, integration and API problems." },
  { id: "account-queue",   name: "Account",   description: "Login, access, roles and account administration." }
]]</typesafe:candidates>
			<typesafe:query>#[output application/json ---
{ request: "I was billed twice for my subscription and need a refund." }]</typesafe:query>
		</typesafe:select-candidate>
		<logger level="INFO" category="typesafe.demo" message="#['[select] ◀ ' ++ write(payload, 'application/json')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- [Policy] Apply  —  GET /apply-policy  (deterministic, no LLM) -->
	<!-- ============================================================= -->
	<flow name="apply-policy-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/apply-policy" allowedMethods="GET" />
		<set-payload value='#[output application/json ---
{
  model: "demo",
  answers: {
    team: {
      "type": "choice",
      choice: "billing",
      probabilities: { billing: 0.62, technical: 0.2, account: 0.13, other: 0.05 },
      confidence: 0.8
    },
    urgent: { "type": "noul", noul: 0.82 },
    sentiment: { "type": "score", score: 1.2, derived: { level: 1 }, confidence: 0.7 }
  }
}]' doc:name="Sample decision" />
		<logger level="INFO" category="typesafe.demo" message="#['[apply-policy] ▶ decision=' ++ write(payload, 'application/json')]" />
		<typesafe:apply-policy config-ref="TypeSafe_Config" questionSet="ticket-triage" doc:name="[Policy] Apply">
			<typesafe:decision>#[payload]</typesafe:decision>
		</typesafe:apply-policy>
		<logger level="INFO" category="typesafe.demo" message="#['[apply-policy] ◀ ' ++ write(payload, 'application/json')]" />
	</flow>

	<!-- ============================================================= -->
	<!-- End-to-end decide chain (§8.8)  —  GET /decide-chain          -->
	<!-- evaluate ▶ apply-policy ▶ route on the action                 -->
	<!-- ============================================================= -->
	<flow name="decide-chain-flow">
		<http:listener config-ref="HTTP_Listener_config" path="/decide-chain" allowedMethods="GET" />
		<flow-ref name="sample-ticket" doc:name="Sample ticket" />
		<logger level="INFO" category="typesafe.demo" message="[decide-chain] ▶ evaluate" />
		<typesafe:evaluate config-ref="TypeSafe_Config" questionSet="ticket-triage" step="triage" doc:name="[Decide] Evaluate">
			<typesafe:state>#[payload]</typesafe:state>
		</typesafe:evaluate>
		<set-variable variableName="decisionPayload" value="#[payload]" doc:name="Keep decision" />
		<logger level="INFO" category="typesafe.demo" message="#['[decide-chain] evaluate ◀ ' ++ write(vars.decisionPayload, 'application/json')]" />
		<typesafe:apply-policy config-ref="TypeSafe_Config" questionSet="ticket-triage" doc:name="[Policy] Apply">
			<typesafe:decision>#[vars.decisionPayload]</typesafe:decision>
		</typesafe:apply-policy>
		<set-variable variableName="decision" value="#[payload]" doc:name="Keep policy result" />
		<choice doc:name="Route on action">
			<when expression="#[vars.decision.action == 'ACCEPT']">
				<logger level="INFO" category="typesafe.demo" message="#['[decide-chain] ◀ ACCEPT — auto-route to ' ++ (vars.decisionPayload.answers.team.choice default 'unknown')]" />
			</when>
			<when expression="#[vars.decision.action == 'REVIEW']">
				<logger level="WARN" category="typesafe.demo" message="#['[decide-chain] ◀ REVIEW — send to a human. reasons=' ++ write(vars.decision.reasons default [], 'application/json')]" />
			</when>
			<otherwise>
				<logger level="ERROR" category="typesafe.demo" message="#['[decide-chain] ◀ REJECT — reasons=' ++ write(vars.decision.reasons default [], 'application/json')]" />
			</otherwise>
		</choice>
		<set-payload value="#[vars.decision]" doc:name="Return policy result" />
	</flow>

</mule>
