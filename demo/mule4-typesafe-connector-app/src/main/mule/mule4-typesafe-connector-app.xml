<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:typesafe="http://www.mulesoft.org/schema/mule/typesafe"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/typesafe http://www.mulesoft.org/schema/mule/typesafe/current/mule-typesafe.xsd">

	<!-- Website Set Up: Protect credentials -->
	<configuration-properties file="local.properties" doc:name="Configuration properties" />

	<!-- Website Set Up: TypeSafe direct -->
	<typesafe:config name="TypeSafe_Config" doc:name="TypeSafe Config">
		<typesafe:typesafe-connection apiKey="${typesafe.apiKey}" model="jev-latest" />
	</typesafe:config>

	<!-- Website Set Up: OpenRouter -->
	<typesafe:config name="TypeSafe_Config_OpenRouter" doc:name="TypeSafe Config OpenRouter">
		<typesafe:openrouter-connection
			apiKey="${openrouter.apiKey}"
			model="~typesafe/jev-latest"
			httpReferer="${app.url}"
			appTitle="${app.name}" />
	</typesafe:config>

	<!-- Sources verification: budget + stats enabled (Set Up → Optional governance) -->
	<typesafe:config name="TypeSafe_Config_Monitoring" doc:name="TypeSafe Config Monitoring"
		statsEnabled="true"
		budgetMaxCallsPerWindow="2"
		budgetWindowSize="1"
		budgetWindowUnit="HOURS">
		<typesafe:typesafe-connection apiKey="${typesafe.apiKey}" model="jev-latest" />
	</typesafe:config>

	<!-- Sources verification: primary connectivity-fail + OpenRouter fallback -->
	<typesafe:config name="TypeSafe_Config_Failover" doc:name="TypeSafe Config Failover"
		statsEnabled="true">
		<typesafe:typesafe-connection
			apiKey="${typesafe.apiKey}"
			model="jev-latest"
			baseUrl="http://127.0.0.1:1"
			responseTimeoutMs="2000">
			<typesafe:fallbacks>
				<typesafe:fallback-route
					route="OPENROUTER"
					apiKey="${openrouter.apiKey}"
					model="~typesafe/jev-latest" />
			</typesafe:fallbacks>
		</typesafe:typesafe-connection>
	</typesafe:config>

	<!-- ================================================================== -->
	<!-- [Util] Connection Get Capabilities — verified; Studio-commented   -->
	<!-- Website: operations/connection-get-capabilities.md                -->
	<!-- ================================================================== -->
<flow name="util-connection-get-capabilities" doc:name="util-connection-get-capabilities">
		<scheduler doc:name="Scheduler">
			<scheduling-strategy>
				<fixed-frequency frequency="1" timeUnit="HOURS" />
			</scheduling-strategy>
		</scheduler>

		<logger level="INFO" doc:name="Start"
			message="[get-capabilities] START - TypeSafe + OpenRouter (scatter-gather)" />

		<scatter-gather doc:name="Get capabilities TypeSafe + OpenRouter">
			<route>
				<typesafe:get-capabilities config-ref="TypeSafe_Config" doc:name="[Util] Connection Get Capabilities" />
				<logger level="INFO" doc:name="Log TypeSafe"
					message="#[output text/plain --- '[get-capabilities] ROUTE=TypeSafe count=' ++ ((attributes.count default sizeOf(payload)) as String) ++ ' attributes=' ++ write(attributes, 'application/json') ++ ' payload=' ++ write(payload, 'application/json')]" />
			</route>
			<route>
				<typesafe:get-capabilities config-ref="TypeSafe_Config_OpenRouter" doc:name="[Util] Connection Get Capabilities OpenRouter" />
				<logger level="INFO" doc:name="Log OpenRouter"
					message="#[output text/plain --- '[get-capabilities] ROUTE=OpenRouter count=' ++ ((attributes.count default sizeOf(payload)) as String) ++ ' attributes=' ++ write(attributes, 'application/json') ++ ' payload=' ++ write(payload, 'application/json')]" />
			</route>
		</scatter-gather>

		<logger level="INFO" doc:name="Done"
			message="[get-capabilities] DONE - see ROUTE=TypeSafe and ROUTE=OpenRouter lines above" />
	</flow>

