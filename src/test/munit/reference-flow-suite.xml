<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:typesafe="http://www.mulesoft.org/schema/mule/typesafe"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd
http://www.mulesoft.org/schema/mule/typesafe http://www.mulesoft.org/schema/mule/typesafe/current/mule-typesafe.xsd">

  <munit:config name="reference-flow-suite.xml"/>

  <!-- Keyless config: exercises the whole decide chain end-to-end against the in-process mock route (§8.8). -->
  <typesafe:config name="TypeSafe">
    <typesafe:mock-connection/>
  </typesafe:config>

  <!--
    Reference flow (§8.8), runnable without a provider key: evaluate a ticket against the ticket-triage question set,
    capture the trace entry, apply the file's policy, then route on the resulting action.
  -->
  <munit:test name="reference-flow-evaluate-policy-route" description="§8.8 decide chain runs end-to-end against mock">
    <munit:execution>
      <typesafe:evaluate config-ref="TypeSafe" questionSet="ticket-triage" step="triage">
        <typesafe:state>#[output application/json --- { subject: "Payment failed", body: "My invoice was charged twice, please refund." }]</typesafe:state>
      </typesafe:evaluate>
      <set-variable variableName="typesafeTrace" value="#[(vars.typesafeTrace default []) ++ [attributes.traceEntry]]"/>
      <typesafe:apply-policy config-ref="TypeSafe" questionSet="ticket-triage" target="decision">
        <typesafe:decision>#[payload]</typesafe:decision>
      </typesafe:apply-policy>
      <choice>
        <when expression="#[vars.decision.action == 'ACCEPT']">
          <set-variable variableName="branch" value="accept"/>
        </when>
        <otherwise>
          <set-variable variableName="branch" value="review"/>
        </otherwise>
      </choice>
    </munit:execution>
    <munit:validation>
      <!-- Canonical §7 payload: the mock concentrates probability on the first option, so team routes to billing. -->
      <munit-tools:assert-that expression="#[payload.answers.team.choice]"
                               is="#[MunitTools::equalTo('billing')]"
                               message="evaluate must produce answers.team.choice"/>
      <!-- team clears its thresholds (0.6 >= 0.55, margin >= 0.15), so its per-question verdict is ACCEPT. -->
      <munit-tools:assert-that expression="#[vars.decision.perQuestion.team.action]"
                               is="#[MunitTools::equalTo('ACCEPT')]"
                               message="team should clear the ticket-triage thresholds"/>
      <!-- sentiment/urgent are below threshold on mock output, so the overall action is not ACCEPT. -->
      <munit-tools:assert-that expression="#[vars.branch]"
                               is="#[MunitTools::equalTo('review')]"
                               message="mock output should route to the review branch"/>
      <munit-tools:assert-that expression="#[sizeOf(vars.typesafeTrace)]"
                               is="#[MunitTools::greaterThan(0)]"
                               message="the trace entry from evaluate must be captured"/>
      <munit-tools:assert-that expression="#[vars.typesafeTrace[0].step]"
                               is="#[MunitTools::equalTo('triage')]"
                               message="the trace entry must record the step"/>
    </munit:validation>
  </munit:test>

  <!-- A misspelt policy key is caught before evaluation and surfaces as the declared typed error. -->
  <munit:test name="apply-policy-rejects-invalid-policy" description="invalid inline policy raises TYPESAFE:INVALID_QUESTION_SET"
              expectedErrorType="TYPESAFE:INVALID_QUESTION_SET">
    <munit:execution>
      <typesafe:apply-policy config-ref="TypeSafe">
        <typesafe:decision>#[output application/json --- { answers: { urgent: { "type": "noul", noul: 0.9 } } }]</typesafe:decision>
        <typesafe:policy>#[output application/json --- { urgent: { acceptAbov: 0.7 } }]</typesafe:policy>
      </typesafe:apply-policy>
    </munit:execution>
  </munit:test>

  <!-- raiseOnReject must reach an error handler as TYPESAFE:REJECTED, not as an undeclared error. -->
  <munit:test name="apply-policy-raises-rejected" description="raiseOnReject raises TYPESAFE:REJECTED"
              expectedErrorType="TYPESAFE:REJECTED">
    <munit:execution>
      <typesafe:apply-policy config-ref="TypeSafe" raiseOnReject="true">
        <typesafe:decision>#[output application/json --- { answers: { urgent: { "type": "noul", noul: 0.1 } } }]</typesafe:decision>
        <typesafe:policy>#[output application/json --- { urgent: { acceptAbove: 0.7, rejectBelow: 0.3 } }]</typesafe:policy>
      </typesafe:apply-policy>
    </munit:execution>
  </munit:test>

  <!-- select-candidate (the ACCEPT branch's action in §8.8) against the mock, over an inline candidate list. -->
  <munit:test name="select-candidate-ranks-against-mock" description="[Select] Candidate runs end-to-end against mock">
    <munit:execution>
      <typesafe:select-candidate config-ref="TypeSafe" idField="Id" labelField="Name" descriptionField="Description">
        <typesafe:candidates>#[output application/json --- [
          { Id: "billing-queue",   Name: "Billing",   Description: "Payments, invoices and refunds." },
          { Id: "technical-queue", Name: "Technical", Description: "Outages, integration and API problems." }
        ]]</typesafe:candidates>
        <typesafe:query>#[output application/json --- "My invoice was charged twice, please refund."]</typesafe:query>
      </typesafe:select-candidate>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.selected]"
                               is="#[MunitTools::notNullValue()]"
                               message="select-candidate must pick a candidate label"/>
      <munit-tools:assert-that expression="#[payload.id]"
                               is="#[MunitTools::equalTo('billing-queue')]"
                               message="mock concentrates probability on the first candidate"/>
      <munit-tools:assert-that expression="#[sizeOf(payload.ranking)]"
                               is="#[MunitTools::greaterThan(0)]"
                               message="select-candidate must return a ranking"/>
    </munit:validation>
  </munit:test>

</mule>
